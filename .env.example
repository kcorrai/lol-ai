# =============================================================================
# LoL AI Coach — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL)
# Local dev: matches docker-compose.yml defaults
# =============================================================================
DATABASE_URL="postgresql://lolai:lolai_dev_password@localhost:5432/lolai_dev"

# =============================================================================
# Cache (Redis)
# Local dev: matches docker-compose.yml defaults
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Authentication (NextAuth / BetterAuth)
# Generate AUTH_SECRET with: openssl rand -base64 32
# =============================================================================
AUTH_SECRET=replace_with_generated_secret
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional for local dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# =============================================================================
# Riot Games API
# Register at: https://developer.riotgames.com
# =============================================================================
RIOT_API_KEY=your_riot_api_key_here

# =============================================================================
# AI Providers
# Set AI_PROVIDER to: openai | anthropic
# Only the selected provider's key is required.
# =============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Stripe (Payments)
# Test keys: https://dashboard.stripe.com/test/apikeys
# Webhook: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRO_MONTHLY_PRICE_ID=price_your_pro_monthly_price_id_here
STRIPE_PRO_YEARLY_PRICE_ID=price_your_pro_yearly_price_id_here

# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@lolaicoach.com

# =============================================================================
# Monitoring (Sentry)
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
