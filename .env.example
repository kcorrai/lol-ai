# =============================================================================
# LoL AI Coach — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL via Neon)
# Local dev: matches docker-compose.yml defaults
# Production (Neon): use the POOLER URLs to route through PgBouncer.
#   Neon Console → Connection Details → Pooled connection → copy URL
#   The pooler URL looks like: postgresql://user:pass@ep-xxx.pooler.neon.tech/db?pgbouncer=true
#   IMPORTANT: Prisma migrations must use the direct (non-pooler) URL.
#   Set DATABASE_URL to the direct URL in CI/migration scripts.
# =============================================================================
DATABASE_URL="postgresql://lolai:lolai_dev_password@localhost:5432/lolai_dev"
# Neon PgBouncer pooler URL — used in Vercel serverless functions to prevent
# connection exhaustion. When set, overrides DATABASE_URL for runtime queries.
# Format: postgresql://user:pass@ep-xxx.pooler.neon.tech/db?pgbouncer=true
DATABASE_POOLER_URL=
# Read replica for analytics/leaderboard queries (Neon Console → Branches → Read Replica)
# Falls back to DATABASE_POOLER_URL / DATABASE_URL if not set (safe for local dev)
DATABASE_READONLY_URL="postgresql://lolai:lolai_dev_password@localhost:5432/lolai_dev"
# Neon PgBouncer pooler URL for the read replica. Optional — falls back to DATABASE_READONLY_URL.
DATABASE_READONLY_POOLER_URL=

# =============================================================================
# Cache (Redis)
# Local dev: matches docker-compose.yml defaults
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Authentication (NextAuth / BetterAuth)
# Generate AUTH_SECRET with: openssl rand -base64 32
# =============================================================================
AUTH_SECRET=replace_with_generated_secret
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional for local dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
# Deprecated name for AUTH_ENCRYPTION_KEY below — still read so existing deployments
# keep working, but set AUTH_ENCRYPTION_KEY on anything new.
# DISCORD_ENCRYPTION_KEY=

# =============================================================================
# Riot Games API
# Register at: https://developer.riotgames.com
# =============================================================================
RIOT_API_KEY=your_riot_api_key_here
# Optional client-side throttle for Riot calls (defaults shown). Tune down if you
# hit rate limits on a personal dev key.
RIOT_RATE_LIMIT_PER_SECOND=20
RIOT_RATE_LIMIT_BURST=20
# Test-only: when "true", riotApiClient returns fixtures instead of calling Riot
# (used by Playwright E2E). Leave unset in normal dev/prod.
E2E_MOCK=

# =============================================================================
# LoL Esports feed (public esports section — ADR-016)
# =============================================================================
# The key the lolesports.com web client ships in its own JavaScript bundle. It is
# public and read-only, tied to no account of ours, and is NOT a secret — it is an
# env var only so it can be repointed without a deploy. Optional: the same value
# is the built-in default. Server-side only; never expose it to the browser.
LOLESPORTS_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z

# =============================================================================
# AI Providers
# Set AI_PROVIDER to: openai | anthropic
# Only the selected provider's key is required.
# =============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Model overrides — defaults shown. Lite model used for lightweight tasks (challenge desc, tilt msg, recap, heatmap).
AI_FULL_MODEL=gpt-4o
AI_LITE_MODEL=gpt-4o-mini

# =============================================================================
# Payments — LemonSqueezy (active provider)
# Dashboard: https://app.lemonsqueezy.com
# API keys: https://app.lemonsqueezy.com/settings/api
# Webhook secret: create at https://app.lemonsqueezy.com/settings/webhooks
#   Events to subscribe: subscription_created, subscription_updated,
#   subscription_cancelled, subscription_expired, subscription_resumed,
#   subscription_payment_failed
# =============================================================================
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_PRO_VARIANT_ID=your_pro_monthly_variant_id_here
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=your_pro_yearly_variant_id_here
LEMONSQUEEZY_TEAM_VARIANT_ID=your_team_monthly_variant_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
# Optional: coupon code for the cancel retention offer (%20 off). Create in LS dashboard first.
LEMONSQUEEZY_RETENTION_COUPON_CODE=


# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=LoL AI Coach <noreply@lolaicoach.gg>

# =============================================================================
# Monitoring (Sentry)
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# =============================================================================
# Distributed Rate Limiting (Upstash Redis — Vercel Marketplace)
# Dashboard: https://console.upstash.com
# Provisioned automatically via Vercel Marketplace integration.
# When both vars are set, rate limits are distributed across all Vercel instances.
# When absent, falls back to per-instance in-memory limiting (best-effort).
#
# Also backs the AI cache since TASK-293 (ADR-014): ai_cache was ~76% of the
# database and all of it regenerable. With these set, cache entries are stored in
# Redis instead of Postgres; without them everything falls back to Postgres, which
# works but puts every cache read and write back on the Neon transfer allowance.
# =============================================================================
KV_REST_API_URL=https://your-redis-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# =============================================================================
# Queue System (Inngest)
# Dashboard: https://app.inngest.com
# INNGEST_EVENT_KEY: send events to Inngest Cloud
# INNGEST_SIGNING_KEY: verify webhook requests from Inngest
# Register app URL in Inngest dashboard: https://your-domain.vercel.app/api/inngest
# =============================================================================
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# =============================================================================
# Web Push Notifications (VAPID)
# Generate keys with: node -e "const wp = require('web-push'); console.log(wp.generateVAPIDKeys())"
# VAPID_SUBJECT: must be a mailto: or https: URL (your contact address)
# =============================================================================
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:noreply@lolaicoach.gg

# =============================================================================
# Analytics (PostHog)
# Dashboard: https://posthog.com
# Both vars are optional; when absent, analytics are silently disabled.
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# =============================================================================
# Admin
# =============================================================================
ADMIN_EMAIL=your_admin_email_here
CRON_SECRET=generate_with_openssl_rand_hex_32
