# =============================================================================
# LoL AI Coach — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# =============================================================================
# Database (PostgreSQL)
# Local dev: matches docker-compose.yml defaults
# =============================================================================
DATABASE_URL="postgresql://lolai:lolai_dev_password@localhost:5432/lolai_dev"
# Read replica for analytics/leaderboard queries (Neon Console → Branches → Read Replica)
# Falls back to DATABASE_URL if not set (safe for local dev)
DATABASE_READONLY_URL="postgresql://lolai:lolai_dev_password@localhost:5432/lolai_dev"

# =============================================================================
# Cache (Redis)
# Local dev: matches docker-compose.yml defaults
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# Authentication (NextAuth / BetterAuth)
# Generate AUTH_SECRET with: openssl rand -base64 32
# =============================================================================
AUTH_SECRET=replace_with_generated_secret
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional for local dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
# 32-byte hex key for webhook URL encryption — generate with: openssl rand -hex 32
DISCORD_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# =============================================================================
# Riot Games API
# Register at: https://developer.riotgames.com
# =============================================================================
RIOT_API_KEY=your_riot_api_key_here

# =============================================================================
# AI Providers
# Set AI_PROVIDER to: openai | anthropic
# Only the selected provider's key is required.
# =============================================================================
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Payments — LemonSqueezy (active provider)
# Dashboard: https://app.lemonsqueezy.com
# API keys: https://app.lemonsqueezy.com/settings/api
# Webhook secret: create at https://app.lemonsqueezy.com/settings/webhooks
#   Events to subscribe: subscription_created, subscription_updated,
#   subscription_cancelled, subscription_expired, subscription_resumed,
#   subscription_payment_failed
# =============================================================================
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key_here
LEMONSQUEEZY_STORE_ID=your_store_id_here
LEMONSQUEEZY_PRO_VARIANT_ID=your_pro_monthly_variant_id_here
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=your_pro_yearly_variant_id_here
LEMONSQUEEZY_TEAM_VARIANT_ID=your_team_monthly_variant_id_here
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here


# =============================================================================
# Email (Resend)
# =============================================================================
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=LoL AI Coach <noreply@lolaicoach.gg>

# =============================================================================
# Monitoring (Sentry)
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# =============================================================================
# Distributed Rate Limiting (Upstash Redis — Vercel Marketplace)
# Dashboard: https://console.upstash.com
# Provisioned automatically via Vercel Marketplace integration.
# When both vars are set, rate limits are distributed across all Vercel instances.
# When absent, falls back to per-instance in-memory limiting (best-effort).
# =============================================================================
KV_REST_API_URL=https://your-redis-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# =============================================================================
# Queue System (Inngest)
# Dashboard: https://app.inngest.com
# INNGEST_EVENT_KEY: send events to Inngest Cloud
# INNGEST_SIGNING_KEY: verify webhook requests from Inngest
# Register app URL in Inngest dashboard: https://your-domain.vercel.app/api/inngest
# =============================================================================
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# =============================================================================
# Admin
# =============================================================================
ADMIN_EMAIL=your_admin_email_here
CRON_SECRET=generate_with_openssl_rand_hex_32
