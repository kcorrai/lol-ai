// LoL AI Coach — Prisma Schema
// Prisma v5, PostgreSQL
// Full MVP schema (TASK-003)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum SubscriptionPlan {
  free
  pro
  elite
  team
}

enum TeamRole {
  OWNER
  COACH
  PLAYER
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

enum QueueType {
  RANKED_SOLO_5x5
  RANKED_FLEX_SR
  NORMAL_BLIND
  NORMAL_DRAFT
  ARAM
  ARENA
  URF
  ONE_FOR_ALL
  NEXUS_BLITZ
}

enum Position {
  TOP
  JUNGLE
  MIDDLE
  BOTTOM
  UTILITY
}

enum RankTier {
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  EMERALD
  DIAMOND
  MASTER
  GRANDMASTER
  CHALLENGER
}

enum RankDivision {
  I
  II
  III
  IV
}

enum ReportType {
  session_review
  champion_focus
  climb_roadmap
}

enum ReportStatus {
  pending
  processing
  complete
  failed
}

enum SyncStatus {
  IDLE
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================
// IDENTITY & AUTH
// NextAuth v4 Prisma Adapter — field names are exact contract.
// DO NOT rename fields in this section without updating the
// NextAuth adapter configuration in TASK-002.
// ============================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  xp               Int @default(0)
  level            Int @default(1)

  profileSlug      String?  @unique
  profilePublic    Boolean  @default(true)
  profileSettings  Json?

  proTrialEndsAt   DateTime?
  emailOptOut      Boolean   @default(false)

  totpEnabled      Boolean   @default(false)
  totpSecret       String?   // AES-encrypted TOTP secret
  totpBackupCodes  String[]  // bcrypt-hashed backup codes

  sessionVersion   Int       @default(0) // incremented to invalidate all active sessions

  accounts         Account[]
  sessions         Session[]
  userSessions     UserSession[]
  profile          Profile?
  subscription     Subscription?
  riotAccounts     RiotAccount[]
  notifications    Notification[]
  shareableCards   ShareableCard[]
  tiltAlerts       TiltAlert[]
  userAchievements UserAchievement[]
  seasonRecaps     SeasonRecap[]
  challenges          Challenge[]
  userChallenges      UserChallenge[]
  discordIntegration  DiscordIntegration?
  referralsGiven      Referral[] @relation("ReferralsGiven")
  referralReceived    Referral?  @relation("ReferralsReceived")
  ownedTeams          Team[]     @relation("TeamOwner")
  teamMemberships     TeamMember[]
  auditLogs           AuditLog[]
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Required by NextAuth for email magic-link / credentials flows.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// USER PROFILE & SUBSCRIPTION
// ============================================================

model Profile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  preferredRole      Position?
  coachingStyle      String    @default("balanced")
  rankGoal           String?
  weeklyPlayHours    Int?
  timezone           String    @default("UTC")
  language           String    @default("en")
  emailWeeklyReport  Boolean   @default(true)
  // Set once the forced first-journey onboarding is completed (TASK-217). Null = not done.
  onboardingCompletedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  // LemonSqueezy IDs (active payment provider)
  lsCustomerId         String?            @unique
  lsSubscriptionId     String?            @unique
  // Stripe IDs retained for historical rows — not used by new checkout flow
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan   @default(free)
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lsCustomerId])
  @@map("subscriptions")
}

// ============================================================
// RIOT INTEGRATION
// ============================================================

model RiotAccount {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  puuid         String
  summonerId    String?
  accountId     String?
  gameName      String
  tagLine       String
  summonerLevel Int
  profileIconId Int
  region        String
  isPrimary     Boolean    @default(false)
  lastSyncedAt  DateTime?
  syncStatus      SyncStatus @default(IDLE)
  syncStartedAt   DateTime?
  syncCompletedAt DateTime?
  lastSyncError   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchParticipants    MatchParticipant[]
  championStats        ChampionStat[]
  rankedHistory        RankedHistory[]
  performanceSnapshots PerformanceSnapshot[]
  coachingReports      CoachingReport[]
  improvementPlans     ImprovementPlan[]
  habits               PlayerHabit[]
  deathEvents          MatchDeathEvent[]

  @@unique([userId, puuid])
  @@index([userId])
  @@map("riot_accounts")
}

// ============================================================
// MATCH DATA
// ============================================================

model Match {
  id           String    @id @default(uuid()) @db.Uuid
  matchId      String    @unique
  region       String
  queueId      Int
  queueType    QueueType
  gameMode     String
  gameDuration Int
  gameStart    DateTime
  gameEnd      DateTime
  gameVersion  String
  winningTeam     Int
  teamObjectives  Json?
  rawDataHash     String
  createdAt    DateTime  @default(now())

  participants MatchParticipant[]
  deathEvents  MatchDeathEvent[]

  @@index([gameStart])
  @@index([queueType, gameStart])
  @@map("matches")
}

model MatchParticipant {
  id                 String   @id @default(uuid()) @db.Uuid
  matchId            String   @db.Uuid
  riotAccountId      String?  @db.Uuid
  puuid              String
  teamId             Int
  championId         Int
  championName       String
  position           Position
  kills              Int
  deaths             Int
  assists            Int
  cs                 Int
  csPerMinute        Decimal  @db.Decimal(5, 2)
  goldEarned         Int
  goldPerMinute      Decimal  @db.Decimal(7, 2)
  damageDealt        Int
  damageTaken        Int
  damageHealed       Int
  visionScore        Int
  wardsPlaced        Int
  wardsKilled        Int
  controlWardsBought Int
  turretsDestroyed   Int
  objectivesStolen   Int
  firstBlood         Boolean
  won                Boolean
  timeSpentDead      Int
  totalTimeCCDealt   Int
  itemIds            Int[]
  runePrimaryPath    Int?
  runePrimaryKeystone Int?
  runeSecondaryPath  Int?
  summonerSpell1     Int
  summonerSpell2     Int
  rankTier           RankTier?
  rankDivision       RankDivision?
  rankLp             Int?
  gameName           String?
  tagLine            String?

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  riotAccount RiotAccount? @relation(fields: [riotAccountId], references: [id])

  @@index([matchId])
  @@index([riotAccountId, matchId])
  @@index([riotAccountId, championId])
  @@map("match_participants")
}

// ============================================================
// CHAMPION REFERENCE DATA
// Note: PK is Int (Riot champion ID), not UUID.
// ============================================================

model Champion {
  id           Int      @id
  key          String   @unique
  name         String
  title        String
  roles        String[]
  difficulty   Int
  imageUrl     String
  patchVersion String
  updatedAt    DateTime @updatedAt

  championStats ChampionStat[]

  @@map("champions")
}

// ============================================================
// ANALYTICS
// ============================================================

model ChampionStat {
  id             String    @id @default(uuid()) @db.Uuid
  riotAccountId  String    @db.Uuid
  championId     Int
  gamesPlayed    Int       @default(0)
  wins           Int       @default(0)
  losses         Int       @default(0)
  avgKda         Decimal   @db.Decimal(5, 2)
  avgKills       Decimal   @db.Decimal(4, 2)
  avgDeaths      Decimal   @db.Decimal(4, 2)
  avgAssists     Decimal   @db.Decimal(4, 2)
  avgCs          Decimal   @db.Decimal(6, 2)
  avgCsPerMinute Decimal   @db.Decimal(5, 2)
  avgVisionScore Decimal   @db.Decimal(5, 2)
  avgDamageDealt Decimal   @db.Decimal(10, 2)
  avgGoldPerMin  Decimal   @db.Decimal(7, 2)
  masteryLevel       Int?
  masteryPoints      BigInt?
  masteryScore       Int?
  masterySubScores   Json?
  masteryScoreAt     DateTime?
  queueType          QueueType
  computedAt         DateTime
  coachingSummary    String?   @db.Text
  coachingSummaryAt  DateTime?

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  champion    Champion    @relation(fields: [championId], references: [id])

  @@unique([riotAccountId, championId, queueType])
  @@index([riotAccountId, gamesPlayed(sort: Desc)])
  @@map("champion_stats")
}

model RankedHistory {
  id            String       @id @default(uuid()) @db.Uuid
  riotAccountId String       @db.Uuid
  queueType     QueueType
  tier          RankTier
  division      RankDivision
  lp            Int
  wins          Int
  losses        Int
  hotStreak     Boolean      @default(false)
  inactive      Boolean      @default(false)
  recordedAt    DateTime

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, queueType, recordedAt(sort: Desc)])
  @@map("ranked_history")
}

model PerformanceSnapshot {
  id                     String   @id @default(uuid()) @db.Uuid
  riotAccountId          String   @db.Uuid
  periodStart            DateTime
  periodEnd              DateTime
  gamesAnalyzed          Int
  winRate                Decimal  @db.Decimal(5, 2)
  avgKda                 Decimal  @db.Decimal(5, 2)
  avgCsPerMinute         Decimal  @db.Decimal(5, 2)
  avgVisionScore         Decimal  @db.Decimal(5, 2)
  tiltScore              Decimal? @db.Decimal(5, 2)
  mostPlayedChampionIds  Int[]
  strongestArea          String?
  weakestArea            String?
  createdAt              DateTime @default(now())

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, periodEnd(sort: Desc)])
  @@map("performance_snapshots")
}

// ============================================================
// AI COACHING
// ============================================================

model CoachingReport {
  id                     String       @id @default(uuid()) @db.Uuid
  riotAccountId          String       @db.Uuid
  reportType             ReportType
  focusArea              String?
  status                 ReportStatus @default(pending)
  matchesAnalyzed        String[]
  summary                String?      @db.Text
  strengths              Json?
  weaknesses             Json?
  actionItems            Json?
  championRecommendations Json?
  estimatedRankPotential String?
  coachPersonaResponse   String?      @db.Text
  userRating             Int?
  userFeedback           String?      @db.Text
  aiModelUsed            String?
  processingTimeMs       Int?
  shareToken             String?      @unique
  createdAt              DateTime     @default(now())
  completedAt            DateTime?

  riotAccount RiotAccount  @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  aiAnalyses  AiAnalysis[]

  @@index([riotAccountId, createdAt(sort: Desc)])
  @@index([status])
  @@map("coaching_reports")
}

model AiAnalysis {
  id               String   @id @default(uuid()) @db.Uuid
  coachingReportId String?  @db.Uuid
  analysisType     String
  inputHash        String   @unique
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Decimal? @db.Decimal(10, 6)
  responseRaw      String   @db.Text
  cacheHit         Boolean  @default(false)
  latencyMs        Int
  createdAt        DateTime @default(now())

  coachingReport CoachingReport? @relation(fields: [coachingReportId], references: [id])

  @@index([coachingReportId])
  @@index([createdAt(sort: Desc)])
  @@map("ai_analyses")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  body      String   @db.Text
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================
// IMPROVEMENT PLANS
// ============================================================

model ImprovementPlan {
  id            String   @id @default(uuid()) @db.Uuid
  riotAccountId String   @db.Uuid
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  // "active" | "expired"
  status        String   @default("active")
  targets       Json

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, status])
  @@map("improvement_plans")
}

// ============================================================
// HABIT DETECTION
// Multi-week recurring weakness patterns detected from
// PerformanceSnapshot history.
// ============================================================

model PlayerHabit {
  id            String    @id @default(uuid()) @db.Uuid
  riotAccountId String    @db.Uuid
  habitType     String    // see habitDetectionService.ts for values
  severity      String    // 'high' | 'medium' | 'low'
  weekCount     Int
  firstDetected DateTime
  lastDetected  DateTime
  isResolved    Boolean   @default(false)
  resolvedAt    DateTime?
  evidence      Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, isResolved])
  @@map("player_habits")
}

// ============================================================
// PATCH TRACKING
// Stores detected DDragon patch versions with their detected date.
// Used to compute before/after WR comparisons for user champion pools.
// ============================================================

model PatchVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @unique  // e.g. "15.14.1"
  detectedAt  DateTime @default(now())
  patchNotesUrl String? // optional link shown in widget

  @@index([detectedAt(sort: Desc)])
  @@map("patch_versions")
}

// ============================================================
// TILT ALERTS
// Persisted notifications sent when a user hits a 3-loss streak.
// AI-generated recovery message, acknowledged via dashboard banner.
// ============================================================

model TiltAlert {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  riotAccountId String   @db.Uuid
  message       String
  streakLength  Int
  acknowledged  Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acknowledged])
  @@map("tilt_alerts")
}

// ============================================================
// DEATH HEAT MAP
// CHAMPION_KILL events from the Riot Match Timeline API, stored per participant.
// Populated by the timelineFetcher Inngest function after match sync.
// ============================================================

model MatchDeathEvent {
  id            String   @id @default(uuid()) @db.Uuid
  matchId       String   @db.Uuid
  riotAccountId String   @db.Uuid
  positionX     Int
  positionY     Int
  gameTimeMs    Int
  championName  String

  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, championName])
  @@index([riotAccountId, gameTimeMs])
  @@index([matchId, riotAccountId])      // fast dedup check: "has this match been processed?"
  @@map("match_death_events")
}

// ============================================================
// ACHIEVEMENTS
// Gamification system: static catalog of achievements + per-user earned records.
// Achievement.id is a slug (e.g. "cs_machine") — not a UUID.
// ============================================================

model Achievement {
  id          String  @id                    // slug e.g. "cs_machine"
  name        String
  description String
  iconSlug    String                         // emoji or asset key shown in UI
  tier        String                         // 'bronze' | 'silver' | 'gold' | 'platinum'
  isSecret    Boolean @default(false)

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String
  earnedAt      DateTime @default(now())
  seen          Boolean  @default(false)     // toast shown to user?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId, seen])
  @@map("user_achievements")
}

// ============================================================
// SEASON RECAP
// Snapshot of a player's performance for a season/split.
// Data is a JSON blob so the schema is forward-compatible as we add more slides.
// ============================================================

model SeasonRecap {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  seasonLabel String   // "2026-S1"
  shareToken  String   @unique @default(cuid())
  data        Json
  generatedAt DateTime @default(now())
  isPublic    Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonLabel])
  @@index([userId, seasonLabel])
  @@map("season_recaps")
}

// ============================================================
// WEBHOOK IDEMPOTENCY
// Prevents duplicate processing when LemonSqueezy retries a delivery.
// Key format: "{event_name}:{subscription_id}:{status}:{renews_at}"
// ============================================================

model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventKey    String   @unique
  processedAt DateTime @default(now())

  @@index([processedAt(sort: Desc)])
  @@map("webhook_events")
}

// ============================================================
// AI CACHE
// Stores AI-generated analysis results keyed by a content hash.
// Shared by all general analysis features (matchup, counter, otp, draft).
// TTL is enforced at read time; expired rows are not auto-deleted.
// ============================================================

model AiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  type      String   // matchup | counter | otp | draft | build-explanation
  content   Json
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([type])
  @@index([expiresAt])
  @@map("ai_cache")
}

// ============================================================
// SHAREABLE CARDS
// Social media / Discord share cards with snapshot data.
// ============================================================

model ShareableCard {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  cardType  String   // 'weekly' | 'mastery'
  token     String   @unique @default(cuid())
  data      Json
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, createdAt(sort: Desc)])
  @@map("shareable_cards")
}

// ============================================================
// CHALLENGES
// Daily / weekly performance goals, AI-generated per user.
// ============================================================

model Challenge {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  type         String   // 'daily' | 'weekly'
  metric       String   // 'cs_per_min' | 'deaths' | 'vision_score' | 'win_streak' | 'kda'
  targetValue  Float
  description  String
  xpReward     Int
  validFrom    DateTime
  validUntil   DateTime
  createdAt    DateTime @default(now())

  userChallenges UserChallenge[]
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, validFrom])
  @@map("challenges")
}

model UserChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  challengeId String    @db.Uuid
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("user_challenges")
}

// ============================================================
// DISCORD INTEGRATION
// Webhook URL stored encrypted. User controls notification types.
// ============================================================

model DiscordIntegration {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  discordUserId    String?
  discordUsername  String?
  webhookUrl       String
  notifyRankUp     Boolean  @default(true)
  notifyBadge      Boolean  @default(false)
  notifyWeekly     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("discord_integrations")
}

model Referral {
  id          String    @id @default(cuid())
  referrerId  String    @db.Uuid
  refereeId   String?   @unique @db.Uuid
  code        String    @unique
  status      String    @default("pending") // pending | completed | rewarded
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  referrer    User      @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referee     User?     @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: SetNull)

  @@map("referrals")
}

// ============================================================
// AUDIT LOGS (SOC2 Prep — TASK-107)
// Append-only immutable event log. Never updated or soft-deleted.
// userId is nulled on GDPR erasure; actorId is preserved for admin audit trail.
// ============================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================
// TEAMS (B2B Pilot — TASK-106)
// Esports teams / coaching academies: one owner, multiple members,
// invite-based onboarding. Requires Team subscription plan.
// ============================================================

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  logoUrl   String?
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User           @relation("TeamOwner", fields: [ownerId], references: [id])
  members    TeamMember[]
  invites    TeamInvite[]
  activities TeamActivity[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid()) @db.Uuid
  teamId   String   @db.Uuid
  userId   String   @db.Uuid
  role     TeamRole @default(PLAYER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvite {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @db.Uuid
  email     String?
  token     String    @unique
  role      TeamRole  @default(PLAYER)
  isLink    Boolean   @default(false)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([token])
  @@map("team_invites")
}

model TeamActivity {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  actorName String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt(sort: Desc)])
  @@map("team_activities")
}

// ============================================================
// FEATURE FLAGS
// ============================================================

model FeatureFlag {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique
  description       String   @default("")
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(100) // 0–100
  // JSON array of plan names (["pro","elite"]) or ["all"]
  userSegment       Json     @default("[\"all\"]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([key])
  @@map("feature_flags")
}

// ============================================================
// WEB PUSH SUBSCRIPTIONS
// ============================================================

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Tracks active JWT sessions for per-device revocation
model UserSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  sessionVersion Int      @default(0)
  userAgent      String?
  ipAddress      String?
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}
