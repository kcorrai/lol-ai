// LoL AI Coach — Prisma Schema
// Prisma v5, PostgreSQL
// Full MVP schema (TASK-003)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum SubscriptionPlan {
  free
  pro
  elite
  team
}

enum TeamRole {
  OWNER
  COACH
  PLAYER
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

enum QueueType {
  RANKED_SOLO_5x5
  RANKED_FLEX_SR
  NORMAL_BLIND
  NORMAL_DRAFT
  ARAM
  ARENA
  URF
  ONE_FOR_ALL
  NEXUS_BLITZ
}

enum Position {
  TOP
  JUNGLE
  MIDDLE
  BOTTOM
  UTILITY
}

enum RankTier {
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  EMERALD
  DIAMOND
  MASTER
  GRANDMASTER
  CHALLENGER
}

enum RankDivision {
  I
  II
  III
  IV
}

enum ReportType {
  session_review
  champion_focus
  climb_roadmap
}

enum ReportStatus {
  pending
  processing
  complete
  failed
}

enum SyncStatus {
  IDLE
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============================================================
// IDENTITY & AUTH
// NextAuth v4 Prisma Adapter — field names are exact contract.
// DO NOT rename fields in this section without updating the
// NextAuth adapter configuration in TASK-002.
// ============================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  xp    Int @default(0)
  level Int @default(1)

  profileSlug     String? @unique
  profilePublic   Boolean @default(true)
  profileSettings Json?

  proTrialEndsAt DateTime?
  emailOptOut    Boolean   @default(false)

  totpEnabled     Boolean  @default(false)
  totpSecret      String? // AES-encrypted TOTP secret
  // `@default([])` is load-bearing, not decoration. Prisma omits a scalar list
  // from the INSERT when the model declares no default, so this NOT NULL column
  // was being filled by the database's own default — and the schema-drift
  // reconciliation dropped that default, which broke registration outright
  // until this was added. See 20260817233500_restore_totp_backup_codes_default.
  totpBackupCodes String[] @default([]) // bcrypt-hashed backup codes

  sessionVersion Int @default(0) // incremented to invalidate all active sessions

  accounts           Account[]
  sessions           Session[]
  userSessions       UserSession[]
  followedTeams      FollowedTeam[]
  profile            Profile?
  subscription       Subscription?
  riotAccounts       RiotAccount[]
  notifications      Notification[]
  shareableCards     ShareableCard[]
  tiltAlerts         TiltAlert[]
  userAchievements   UserAchievement[]
  seasonRecaps       SeasonRecap[]
  challenges         Challenge[]
  userChallenges     UserChallenge[]
  discordIntegration DiscordIntegration?
  referralsGiven     Referral[]          @relation("ReferralsGiven")
  referralReceived   Referral?           @relation("ReferralsReceived")
  ownedTeams         Team[]              @relation("TeamOwner")
  teamMemberships    TeamMember[]
  auditLogs          AuditLog[]
  pushSubscriptions  PushSubscription[]
  draftSeries        DraftSeries[]
  quizAttempts       QuizAttempt[]
  quizStreak         QuizStreak?

  // Coach marketplace. `coachProfile` is what makes this account a coach — there
  // is no role column, by design (ADR-019). Everything else here is the same
  // account acting as a student, which is the common case: coaches queue too.
  coachProfile          CoachProfile?    @relation("CoachProfileUser")
  coachProfilesReviewed CoachProfile[]   @relation("CoachProfileReviewer")
  bookingsAsStudent     Booking[]        @relation("BookingStudent")
  bookingEvents         BookingEvent[]   @relation("BookingEventActor")
  sessionReviews        SessionReview[]  @relation("SessionReviewStudent")
  conversations         Conversation[]   @relation("ConversationStudent")
  messagesSent          Message[]        @relation("MessageSender")
  disputesOpened        BookingDispute[] @relation("DisputeOpener")
  disputesResolved      BookingDispute[] @relation("DisputeResolver")

  // Academy
  academyProgress    AcademyProgress[]
  academyEnrollments AcademyEnrollment[]
  academyAssignments AcademyAssignment[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Required by NextAuth for email magic-link / credentials flows.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// USER PROFILE & SUBSCRIPTION
// ============================================================

model Profile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @db.Uuid
  preferredRole         Position?
  coachingStyle         String    @default("balanced")
  rankGoal              String?
  weeklyPlayHours       Int?
  timezone              String    @default("UTC")
  language              String    @default("en")
  emailWeeklyReport     Boolean   @default(true)
  // Set once the forced first-journey onboarding is completed (TASK-217). Null = not done.
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @db.Uuid
  // LemonSqueezy IDs (active payment provider)
  lsCustomerId         String?            @unique
  lsSubscriptionId     String?            @unique
  // Stripe IDs retained for historical rows — not used by new checkout flow
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan   @default(free)
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lsCustomerId])
  @@map("subscriptions")
}

// ============================================================
// RIOT INTEGRATION
// ============================================================

model RiotAccount {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  puuid           String
  summonerId      String?
  accountId       String?
  gameName        String
  tagLine         String
  summonerLevel   Int
  profileIconId   Int
  region          String
  isPrimary       Boolean    @default(false)
  lastSyncedAt    DateTime?
  syncStatus      SyncStatus @default(IDLE)
  syncStartedAt   DateTime?
  syncCompletedAt DateTime?
  lastSyncError   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchParticipants    MatchParticipant[]
  championStats        ChampionStat[]
  rankedHistory        RankedHistory[]
  performanceSnapshots PerformanceSnapshot[]
  coachingReports      CoachingReport[]
  improvementPlans     ImprovementPlan[]
  habits               PlayerHabit[]
  deathEvents          MatchDeathEvent[]
  duoPartners          DuoPartner[]
  duoQuests            DuoQuest[]
  // Marketplace: the account a rank badge was read from, and the account a
  // student asked a coach to look at. Both are SetNull — unlinking a Riot
  // account must not delete a coach's profile or a settled booking.
  coachRankProofs      CoachRankProof[]
  bookingsUnderReview  Booking[]

  @@unique([userId, puuid])
  @@index([userId])
  // Raw-SQL index from 20260607000012_analytics_indexes (admin DAU/MAU proxy), mirrored here so
  // the next `migrate dev` stops proposing to drop it — see LA-15.
  @@index([updatedAt(sort: Desc)], map: "idx_riot_accounts_updated_at")
  @@map("riot_accounts")
}

// A teammate the player marks as their duo. Identified by puuid, but gameName/tagLine are stored
// alongside so the partner still renders if they change their Riot ID or leave the match window.
// Rows are kept after deselection (isActive=false) so switching back doesn't lose the history.
model DuoPartner {
  id            String   @id @default(uuid()) @db.Uuid
  riotAccountId String   @db.Uuid
  puuid         String
  gameName      String
  tagLine       String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@unique([riotAccountId, puuid])
  @@index([riotAccountId, isActive])
  @@map("duo_partners")
}

// A weekly goal for one pair. Which quests run in a week is derived from the week number
// (duoQuestCatalog), so nothing about the definition is stored — only this pair's progress
// against it, and whether the XP has already been paid out.
model DuoQuest {
  id            String    @id @default(uuid()) @db.Uuid
  riotAccountId String    @db.Uuid
  partnerPuuid  String
  key           String
  target        Int
  // The current value in the quest's own unit (games, wins, kills), not a fraction: the panel
  // shows "3 / 5", and a fraction would have to be multiplied back out to say that.
  progress      Int       @default(0)
  completed     Boolean   @default(false)
  completedAt   DateTime?
  xpReward      Int
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  // One row per pair per quest per week. This is also what makes generation idempotent: reading
  // the panel twice cannot create a second copy or pay the XP twice.
  @@unique([riotAccountId, partnerPuuid, key, periodStart])
  @@index([riotAccountId, periodStart])
  @@map("duo_quests")
}

// Every Riot ID we have ever seen, so search can autocomplete.
//
// Riot exposes no name-search endpoint — account-v1 needs an exact gameName *and* tagLine — so
// an index of our own is the only way to suggest anything while a player types. The rows come
// free: each synced match carries ten players, nine of whom are nobody's connected account.
// See ADR-017.
model PlayerIndex {
  puuid         String   @id
  gameName      String
  tagLine       String
  region        String
  // Lowercased gameName, stored rather than computed: prefix search needs a case-insensitive
  // column of its own, because `ILIKE 'x%'` cannot use a btree index and `LIKE 'x%'` against
  // text_pattern_ops can.
  searchKey     String
  profileIconId Int?
  summonerLevel Int?
  // How many synced matches this player has turned up in. A name seen in fifty of our matches
  // is a likelier target than one seen once, which is the whole ranking signal.
  seenCount     Int      @default(0)
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Declared plain here, but created with `text_pattern_ops` by
  // 20260816000001_add_player_index — and that is deliberate, not a mistake to fix (LA-15).
  //
  // Prisma 5.22 cannot introspect a non-default operator class: `db pull` reads both of these
  // back as plain `@@index([searchKey])`. So while the model said `ops: raw("text_pattern_ops")`
  // every `migrate dev` proposed dropping and recreating them — identical SQL, forever, because
  // the two sides can never agree. Declaring them plain makes Prisma see a match and leave them
  // alone, and the operator class survives where it actually lives: in the migration that
  // creates the index. Never let Prisma regenerate these; the migration SQL is their source of
  // truth. See the comment on `searchKey` for why the operator class matters at all.
  @@index([searchKey])
  @@index([region, searchKey])
  @@map("player_index")
}

// ============================================================
// MATCH DATA
// ============================================================

model Match {
  id             String    @id @default(uuid()) @db.Uuid
  matchId        String    @unique
  region         String
  queueId        Int
  queueType      QueueType
  gameMode       String
  gameDuration   Int
  gameStart      DateTime
  gameEnd        DateTime
  gameVersion    String
  winningTeam    Int
  teamObjectives Json?
  rawDataHash    String
  createdAt      DateTime  @default(now())

  participants MatchParticipant[]
  deathEvents  MatchDeathEvent[]

  @@index([gameStart])
  @@index([queueType, gameStart])
  @@map("matches")
}

model MatchParticipant {
  id                  String        @id @default(uuid()) @db.Uuid
  matchId             String        @db.Uuid
  riotAccountId       String?       @db.Uuid
  puuid               String
  teamId              Int
  championId          Int
  championName        String
  position            Position
  kills               Int
  deaths              Int
  assists             Int
  cs                  Int
  csPerMinute         Decimal       @db.Decimal(5, 2)
  goldEarned          Int
  goldPerMinute       Decimal       @db.Decimal(7, 2)
  damageDealt         Int
  damageTaken         Int
  damageHealed        Int
  visionScore         Int
  wardsPlaced         Int
  wardsKilled         Int
  controlWardsBought  Int
  turretsDestroyed    Int
  objectivesStolen    Int
  firstBlood          Boolean
  won                 Boolean
  timeSpentDead       Int
  totalTimeCCDealt    Int
  itemIds             Int[]
  runePrimaryPath     Int?
  runePrimaryKeystone Int?
  runeSecondaryPath   Int?
  summonerSpell1      Int
  summonerSpell2      Int
  rankTier            RankTier?
  rankDivision        RankDivision?
  rankLp              Int?
  gameName            String?
  tagLine             String?

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  riotAccount RiotAccount? @relation(fields: [riotAccountId], references: [id])

  @@index([matchId])
  @@index([riotAccountId, matchId])
  @@index([riotAccountId, championId])
  // riotAccountId is null for the nine participants that are not a connected
  // account, so opponent- and pre-link lookups must go through puuid instead.
  @@index([puuid])
  @@map("match_participants")
}

// ============================================================
// CHAMPION REFERENCE DATA
// Note: PK is Int (Riot champion ID), not UUID.
// ============================================================

model Champion {
  id           Int      @id
  key          String   @unique
  name         String
  title        String
  roles        String[]
  difficulty   Int
  imageUrl     String
  patchVersion String
  updatedAt    DateTime @updatedAt

  championStats ChampionStat[]

  @@map("champions")
}

// ============================================================
// ANALYTICS
// ============================================================

model ChampionStat {
  id                String    @id @default(uuid()) @db.Uuid
  riotAccountId     String    @db.Uuid
  championId        Int
  gamesPlayed       Int       @default(0)
  wins              Int       @default(0)
  losses            Int       @default(0)
  avgKda            Decimal   @db.Decimal(5, 2)
  avgKills          Decimal   @db.Decimal(4, 2)
  avgDeaths         Decimal   @db.Decimal(4, 2)
  avgAssists        Decimal   @db.Decimal(4, 2)
  avgCs             Decimal   @db.Decimal(6, 2)
  avgCsPerMinute    Decimal   @db.Decimal(5, 2)
  avgVisionScore    Decimal   @db.Decimal(5, 2)
  avgDamageDealt    Decimal   @db.Decimal(10, 2)
  avgGoldPerMin     Decimal   @db.Decimal(7, 2)
  masteryLevel      Int?
  masteryPoints     BigInt?
  masteryScore      Int?
  masterySubScores  Json?
  masteryScoreAt    DateTime?
  queueType         QueueType
  computedAt        DateTime
  coachingSummary   String?   @db.Text
  coachingSummaryAt DateTime?

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  champion    Champion    @relation(fields: [championId], references: [id])

  @@unique([riotAccountId, championId, queueType])
  @@index([riotAccountId, gamesPlayed(sort: Desc)])
  @@map("champion_stats")
}

model RankedHistory {
  id            String       @id @default(uuid()) @db.Uuid
  riotAccountId String       @db.Uuid
  queueType     QueueType
  tier          RankTier
  division      RankDivision
  lp            Int
  wins          Int
  losses        Int
  hotStreak     Boolean      @default(false)
  inactive      Boolean      @default(false)
  recordedAt    DateTime

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, queueType, recordedAt(sort: Desc)])
  // Added as raw SQL by 20260607000012_analytics_indexes for the leaderboard query and never
  // mirrored here, which is how schema.prisma and the migration history drifted apart (LA-15).
  // The `map` keeps the hand-written name the database already has.
  @@index([riotAccountId, recordedAt(sort: Desc)], map: "idx_ranked_history_account_recorded")
  @@map("ranked_history")
}

model PerformanceSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  riotAccountId         String   @db.Uuid
  periodStart           DateTime
  periodEnd             DateTime
  gamesAnalyzed         Int
  winRate               Decimal  @db.Decimal(5, 2)
  avgKda                Decimal  @db.Decimal(5, 2)
  avgCsPerMinute        Decimal  @db.Decimal(5, 2)
  avgVisionScore        Decimal  @db.Decimal(5, 2)
  tiltScore             Decimal? @db.Decimal(5, 2)
  mostPlayedChampionIds Int[]
  strongestArea         String?
  weakestArea           String?
  createdAt             DateTime @default(now())

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, periodEnd(sort: Desc)])
  @@map("performance_snapshots")
}

// ============================================================
// AI COACHING
// ============================================================

model CoachingReport {
  id                      String       @id @default(uuid()) @db.Uuid
  riotAccountId           String       @db.Uuid
  reportType              ReportType
  focusArea               String?
  status                  ReportStatus @default(pending)
  matchesAnalyzed         String[]
  summary                 String?      @db.Text
  strengths               Json?
  weaknesses              Json?
  actionItems             Json?
  championRecommendations Json?
  estimatedRankPotential  String?
  coachPersonaResponse    String?      @db.Text
  userRating              Int?
  userFeedback            String?      @db.Text
  aiModelUsed             String?
  processingTimeMs        Int?
  shareToken              String?      @unique
  createdAt               DateTime     @default(now())
  completedAt             DateTime?

  riotAccount RiotAccount  @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)
  aiAnalyses  AiAnalysis[]

  @@index([riotAccountId, createdAt(sort: Desc)])
  @@index([status])
  // Raw-SQL index from 20260607000012_analytics_indexes (admin feature-usage counts), mirrored
  // here so the next `migrate dev` stops proposing to drop it — see LA-15.
  @@index([createdAt(sort: Desc)], map: "idx_coaching_reports_created_at")
  @@map("coaching_reports")
}

model AiAnalysis {
  id               String   @id @default(uuid()) @db.Uuid
  coachingReportId String?  @db.Uuid
  analysisType     String
  inputHash        String   @unique
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Decimal? @db.Decimal(10, 6)
  responseRaw      String   @db.Text
  cacheHit         Boolean  @default(false)
  latencyMs        Int
  createdAt        DateTime @default(now())

  coachingReport CoachingReport? @relation(fields: [coachingReportId], references: [id])

  @@index([coachingReportId])
  @@index([createdAt(sort: Desc)])
  @@map("ai_analyses")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  body      String   @db.Text
  actionUrl String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ============================================================
// IMPROVEMENT PLANS
// ============================================================

model ImprovementPlan {
  id            String   @id @default(uuid()) @db.Uuid
  riotAccountId String   @db.Uuid
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  // "active" | "expired"
  status        String   @default("active")
  targets       Json

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, status])
  @@map("improvement_plans")
}

// ============================================================
// HABIT DETECTION
// Multi-week recurring weakness patterns detected from
// PerformanceSnapshot history.
// ============================================================

model PlayerHabit {
  id            String    @id @default(uuid()) @db.Uuid
  riotAccountId String    @db.Uuid
  habitType     String // see habitDetectionService.ts for values
  severity      String // 'high' | 'medium' | 'low'
  weekCount     Int
  firstDetected DateTime
  lastDetected  DateTime
  isResolved    Boolean   @default(false)
  resolvedAt    DateTime?
  evidence      Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, isResolved])
  @@map("player_habits")
}

// ============================================================
// PATCH TRACKING
// Stores detected DDragon patch versions with their detected date.
// Used to compute before/after WR comparisons for user champion pools.
// ============================================================

model PatchVersion {
  id            String   @id @default(uuid()) @db.Uuid
  version       String   @unique // e.g. "15.14.1"
  detectedAt    DateTime @default(now())
  patchNotesUrl String? // optional link shown in widget

  @@index([detectedAt(sort: Desc)])
  @@map("patch_versions")
}

// ============================================================
// TILT ALERTS
// Persisted notifications sent when a user hits a 3-loss streak.
// AI-generated recovery message, acknowledged via dashboard banner.
// ============================================================

model TiltAlert {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  riotAccountId String   @db.Uuid
  message       String
  streakLength  Int
  acknowledged  Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acknowledged])
  @@map("tilt_alerts")
}

// ============================================================
// DEATH HEAT MAP
// CHAMPION_KILL events from the Riot Match Timeline API, stored per participant.
// Populated by the timelineFetcher Inngest function after match sync.
// ============================================================

model MatchDeathEvent {
  id            String   @id @default(uuid()) @db.Uuid
  matchId       String   @db.Uuid
  riotAccountId String   @db.Uuid
  positionX     Int
  positionY     Int
  gameTimeMs    Int
  championName  String
  // Present in the database since 20260607000004_add_death_events and missing from this model,
  // which is why `migrate dev` wanted to drop the column outright (LA-15). Kept, not dropped:
  // the rows are cheap and knowing when a death was ingested is the only way to tell a
  // re-processed match from a freshly synced one.
  createdAt     DateTime @default(now())

  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  riotAccount RiotAccount @relation(fields: [riotAccountId], references: [id], onDelete: Cascade)

  @@index([riotAccountId, championName])
  @@index([riotAccountId, gameTimeMs])
  @@index([matchId, riotAccountId]) // fast dedup check: "has this match been processed?"
  @@map("match_death_events")
}

// ============================================================
// ACHIEVEMENTS
// Gamification system: static catalog of achievements + per-user earned records.
// Achievement.id is a slug (e.g. "cs_machine") — not a UUID.
// ============================================================

model Achievement {
  id          String  @id // slug e.g. "cs_machine"
  name        String
  description String
  iconSlug    String // emoji or asset key shown in UI
  tier        String // 'bronze' | 'silver' | 'gold' | 'platinum'
  isSecret    Boolean @default(false)

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  achievementId String
  earnedAt      DateTime @default(now())
  seen          Boolean  @default(false) // toast shown to user?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId, seen])
  @@map("user_achievements")
}

// ============================================================
// SEASON RECAP
// Snapshot of a player's performance for a season/split.
// Data is a JSON blob so the schema is forward-compatible as we add more slides.
// ============================================================

model SeasonRecap {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  seasonLabel String // "2026-S1"
  shareToken  String   @unique @default(cuid())
  data        Json
  generatedAt DateTime @default(now())
  isPublic    Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonLabel])
  @@index([userId, seasonLabel])
  @@map("season_recaps")
}

// ============================================================
// WEBHOOK IDEMPOTENCY
// Prevents duplicate processing when LemonSqueezy retries a delivery.
// Key format: "{event_name}:{subscription_id}:{status}:{renews_at}"
// ============================================================

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventKey    String    @unique
  // Null means "claimed but not finished" — the row is inserted before the
  // handler runs (so concurrent deliveries dedupe) and stamped afterwards. A
  // crashed or failed attempt leaves it null, which lets the retry reprocess
  // instead of being swallowed as a duplicate. See TASK-270.
  processedAt DateTime?

  @@index([processedAt(sort: Desc)])
  @@map("webhook_events")
}

// ============================================================
// AI CACHE
// Stores AI-generated analysis results keyed by a content hash.
// Shared by all general analysis features (matchup, counter, otp, draft).
// TTL is enforced at read time; expired rows are not auto-deleted.
// ============================================================

model AiCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  type      String // matchup | counter | otp | draft | build-explanation
  content   Json
  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([type])
  @@index([expiresAt])
  @@map("ai_cache")
}

// ============================================================
// SHAREABLE CARDS
// Social media / Discord share cards with snapshot data.
// ============================================================

model ShareableCard {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  cardType  String // 'weekly' | 'mastery'
  token     String   @unique @default(cuid())
  data      Json
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No `@@index([token])`: `token` is already `@unique`, and a unique constraint is a btree index.
  // The duplicate was in the model but never in any migration, so it was one of the differences
  // that made `migrate dev` untrustworthy (LA-15). Dropped in the model, not added to the database.
  @@index([userId, createdAt(sort: Desc)])
  @@map("shareable_cards")
}

// ============================================================
// CHALLENGES
// Daily / weekly performance goals, AI-generated per user.
// ============================================================

model Challenge {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  type        String // 'daily' | 'weekly'
  metric      String // 'cs_per_min' | 'deaths' | 'vision_score' | 'win_streak' | 'kda'
  targetValue Float
  description String
  xpReward    Int
  validFrom   DateTime
  validUntil  DateTime
  createdAt   DateTime @default(now())

  userChallenges UserChallenge[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, validFrom])
  @@map("challenges")
}

model UserChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  challengeId String    @db.Uuid
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("user_challenges")
}

// ============================================================
// DISCORD INTEGRATION
// Webhook URL stored encrypted. User controls notification types.
